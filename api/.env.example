# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/quizarena
# OBLIGATOIRE, 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=*
# Hébergé derrière un proxy (Render, Railway…) : mettre 1.
TRUST_PROXY=0
# Requêtes /auth autorisées par IP et par 15 minutes.
AUTH_RATE_LIMIT_MAX=20
